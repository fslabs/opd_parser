build --verbose_failures
build --disk_cache=~/.cache/bazel-disk
build --lockfile_mode=update

# Clippy on every build; cached, so repeat runs cost nothing.
build --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build --output_groups=+clippy_checks

# Proc macros and build tools run once and do not ship.
build --host_compilation_mode=fastbuild

build --keep_going
test --build_tests_only
test --test_output=errors
test --local_test_jobs=HOST_CPUS

# Prow's bazel-tests job runs `bazel test --config=ci`, so this config has to
# exist. It carries no remote flags on purpose: this repo opts out of Buildbarn
# (`bazel_test.remote = false` in infra) because one crate over three public
# dependencies builds locally in well under a minute, and RBE would only add a
# dependency on a bearer token whose credential helper lives in fsl_libs.
# Re-enabling RBE means restoring that preset AND vendoring the helper.
common:ci --lockfile_mode=update
build:ci --repository_cache=/bazel-cache/repo-cache

try-import %workspace%/.bazelrc.ci
try-import %workspace%/.bazelrc.user
